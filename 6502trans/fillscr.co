PSH 0 WRD $10

PSH 2 WRD $11

PSH 1
PSH 2
PSH 3

LOOP:
	
	JSR WRITE
	JMP LOOP
HLT


WRITE:
	ROT DUP
	RDD $10 RDD $11 WRD

	RDD $10 INC DUP WRD $10

	JZ INC_HI
	RTS

INC_HI:
	
	RDD $11 INC DUP SUB 6

	JZ RESET_HI

	WRD $11
	RTS

RESET_HI:
	PSH 2 WRD $11
	
	POP 
	
	INC
	ROT
	INC
	ROT
	INC
	ROT
	PSH 1
	WRD $2001

	RTS
