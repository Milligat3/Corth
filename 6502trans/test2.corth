@macro CHECK_ROT(a, b, c)
	
	@macro ROT_DUP (addr)

		@macro DUP_WRITE (addr)
			DUP
			WRD addr
		@macro_end
		ROT
		DUP_WRITE (addr)
	@macro_end
	@macro DRAW()
		PSH 1
		WRD $2001
	@macro_end
	@macro PSH_ABC (a, b, c)
		PSH a
		PSH b
		PSH c
	@macro_end

	PSH_ABC (a, b, c)
	ROT_DUP($300)
	ROT_DUP($301)
	ROT_DUP($302)

	DRAW ()
@macro_end


CHECK_ROT(1, 2, 3)
TRAP: JMP TRAP