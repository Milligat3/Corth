@macro FOR(i, start, end, loop, body)
	PSH start
	WRD i
	LABEL loop
	body

	RDD i
	INC
	DUP
	WRD i
	LT end
	JNZ loop
@macro_end

@macro MULT(ADDR, FACTOR, LOOP)
	PSH 0
	FOR($1, 0, FACTOR, LOOP,
		RDD ADDR
		ADD
	)
	WRD ADDR
@macro_end

@macro DRAW()
	PSH 1
	WRD $2001
@macro_end

PSH 2
WRD $300
MULT($300, 5, LP_1)
DRAW()
TRAP: JMP TRAP
