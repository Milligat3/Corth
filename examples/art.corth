PSH 0
PSH 0
PSH 1
WRD
PSH 2
PSH 1
PSH 1
WRD

PSH 0

LOOP:
	
	DUP
	JSR WRITE
	JMP LOOP
HLT

WRITE:
	PSH 0
	PSH 1
	RDD
	INC
	DUP

	PSH 0
	PSH 1
	WRD

	DUP
	JZ INC_HI

	PSH 0
	PSH 2
	RDD

	DUP
	PSH 6
	SUB
	JZ RESET_HI
ACTUAL_WRITE:
	WRD
	RTS
INC_HI:
	
	PSH 0
	PSH 2
	RDD

	DUP
	PSH 6
	SUB
	JZ RESET_HI

	INC
	DUP

	PSH 0
	PSH 2
	WRD

	JMP ACTUAL_WRITE

RESET_HI:
	
	POP

	PSH 2

	DUP
	
	PSH 0
	PSH 2
	WRD

	JMP ACTUAL_WRITE