#include "ast.h"


int parse_arg_of_mnem(token_table_t *tts, size_t *i)
{
	token_table_t tknzr_3;
	size_t j;
	AstBuilder_t tt;
	AstNode_t *to_eval;
	token_t *this_tok;
	tknzr_3 = init_tt();
	for(j = *i+1; j < tts->size; j++)
	{
		this_tok = &tts->tokens[j];
		if(this_tok->type == TKN_CONST || this_tok->type == TKN_BINOP)
		{
			push_token(&tknzr_3, *this_tok);
			continue;
		}
		
		break;
	}
	tt.tt = tknzr_3;
	tt.pos = 0;
	to_eval = parse_expr(&tt);
	*i = j-1;
	return eval(to_eval);	
}

int check_syntax(token_table_t *tknzr)
{
	token_table_t tknzr_tmp;
	token_table_t *tknzr2;
	token_table_t tkn_string;
	size_t size_of_str;
	int found_err;
	size_t i;
	int num;
	int idx;
	token_t next_tok;
	token_t *tkn;
	token_t new_token;
	token_t next_tkn;

	tknzr_tmp = init_tt();
	tknzr2	= &tknzr_tmp;
	tkn_string = *tknzr;
	size_of_str = tknzr->size;
	found_err = 0;
	for(i = 0; i < size_of_str; i++)
	{
		tkn = &tkn_string.tokens[i];
		switch(tkn->type)
		{
			case TKN_PSH:
			{
				next_tok = tkn_string.tokens[i + 1];
				if(next_tok.type != TKN_CONST)
				{
					printf("Not a valid digit operand after PSH: %s\n", next_tok.tkn_str);
					found_err = 1;
					continue;
				}
				num = parse_arg_of_mnem(tknzr, &i);
				new_token = *tkn;
				
				if(num < 0x100)
				{
					new_token.val.num[0] = num;
				}
				else if(num < 0x10000)
				{
					new_token.type = TKN_PSH_WORD;
					new_token.val.num[0] = num & 0xFF;
					new_token.val.num[1] = num >> 8;
				}
				else
				{
					printf("Not a valid digit operand after PSH: %s\n", next_tok.tkn_str);
					found_err = 1;
					continue;
				}
				
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_PSH_WORD:
			{
				next_tok = tkn_string.tokens[i + 1];
				if(next_tok.type != TKN_CONST)
				{
					printf("Not a valid digit operand after PSH_W: %s\n", next_tok.tkn_str);
					found_err = 1;
					continue;
				}
				num = parse_arg_of_mnem(tknzr, &i);
				new_token = *tkn;
				
				if(num < 0x10000)
				{
					new_token.val.num[0] = num & 0xFF;
					new_token.val.num[1] = num >> 8;
				}
				else
				{
					printf("Not a valid digit operand after PSH_W: %s\n", next_tok.tkn_str);
					found_err = 1;
					continue;
				}
				
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_JMP:
			{
				next_tok = tkn_string.tokens[++i];
				idx = jmp_in_labels(next_tok.tkn_str); 
				if(idx == -1)
				{
					printf("Not a valid label after JMP: %s\n", next_tok.tkn_str);
					found_err = 1;
				}
				new_token = *tkn;
				new_token.val.num[0] = idx;
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_JNZ:
			{
				next_tok = tkn_string.tokens[++i];
				idx = jmp_in_labels(next_tok.tkn_str); 
				if(idx == -1)
				{
					printf("Not a valid label after JNZ: %s\n", next_tok.tkn_str);
					found_err = 1;
				}
				new_token = *tkn;
				new_token.val.num[0] = idx;
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_JZ:
			{
				next_tok = tkn_string.tokens[++i];
				idx = jmp_in_labels(next_tok.tkn_str); 
				if(idx == -1)
				{
					printf("Not a valid label after JZ: %s\n", next_tok.tkn_str);
					found_err = 1;
				}
				new_token = *tkn;
				new_token.val.num[0] = idx;
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_JSR:
			{
				next_tok = tkn_string.tokens[++i];
				idx = jmp_in_labels(next_tok.tkn_str); 
				if(idx == -1)
				{
					printf("Not a valid label after JSR: %s\n", next_tok.tkn_str);
					found_err = 1;
				}
				new_token = *tkn;
				new_token.val.num[0] = idx;
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_JCC:
			{
				next_tok = tkn_string.tokens[++i];
				idx = jmp_in_labels(next_tok.tkn_str); 
				if(idx == -1)
				{
					printf("Not a valid label after JCC: %s\n", next_tok.tkn_str);
					found_err = 1;
				}
				new_token = *tkn;
				new_token.val.num[0] = idx;
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_JCS:
			{
				next_tok = tkn_string.tokens[++i];
				idx = jmp_in_labels(next_tok.tkn_str); 
				if(idx == -1)
				{
					printf("Not a valid label after JCS: %s\n", next_tok.tkn_str);
					found_err = 1;
				}
				new_token = *tkn;
				new_token.val.num[0] = idx;
				push_token(tknzr2, new_token);
				continue;
			}
			case TKN_POP:
			{
				push_token(tknzr2, *tkn);
				continue;
			}
			case TKN_POP_WORD:
			{
				push_token(tknzr2, *tkn);
				continue;
			}
		
			case TKN_ADD:
			{
				next_tkn = tkn_string.tokens[i+1];
				if(next_tkn.type == TKN_CONST)
				{
					
					num = parse_arg_of_mnem(tknzr, &i);
					if(num > 0xFF)
					{
						printf("The number is bigger than 0xFF for immediate ADD. Abort.\n");
						found_err = 1;
					}
					new_token = *tkn;
					new_token.type = TKN_ADD_IMM;
					new_token.val.num[0] = num;
					push_token(tknzr2, new_token);
					
					continue;
				}
				push_token(tknzr2, *tkn);
	
				continue;
			}
			case TKN_SUB:
			{
				next_tkn = tkn_string.tokens[i+1];
				if(next_tkn.type == TKN_CONST)
				{
					num = parse_arg_of_mnem(tknzr, &i);
					if(num > 0xFF)
					{
						printf("The number is bigger than 0xFF for immediate SUB. Abort.\n");
						found_err = 1;
					}
					new_token = *tkn;
					new_token.type = TKN_SUB_IMM;
					new_token.val.num[0] = num;
					push_token(tknzr2, new_token);
					continue;
				}
				push_token(tknzr2, *tkn);
				continue;
			}
			case TKN_ADD_WORD:
			{
				next_tkn = tkn_string.tokens[i+1];
				if(next_tkn.type == TKN_CONST)
				{
					
					num = parse_arg_of_mnem(tknzr, &i);
					if(num > 0xFFFF)
