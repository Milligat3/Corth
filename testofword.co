@def FP $1

@macro GET_SP()
	ASM
	{
		txa
		jsr OP_PUSH
	}
@macro_end

@macro SET_SP()
	ASM
	{
		jsr OP_POP
		tax
	}
@macro_end

@macro PROLOGUE()
	ASM
	{
		lda $1
		pha
		dex
		txa
		sec
		sbc $700, X
		sta $1
	}
@macro_end

@macro EPILOGUE()
	ASM
	{
		dex
		lda $1
		clc
		adc $700, X
		tax
		pla
		sta $1
	}
@macro_end

@macro PEEK_LOCAL(idx)
	RDD FP
	PSH idx
	ADD
	PEEK
@macro_end

@macro POKE_LOCAL_I(idx, val)
	PSH val
	RDD FP
	PSH idx
	ADD
	POKE
@macro_end


@macro POKE_LOCAL(idx)
	RDD FP
	PSH idx
	ADD
	POKE
@macro_end

@macro PEEK_LOCAL_W(idx)
	RDD FP
	PSH idx*2
	ADD
	PEEK_W
@macro_end

@macro POKE_LOCAL_I_W(idx, val)
	PSH_W val
	RDD FP
	PSH idx*2
	ADD
	POKE_W
@macro_end


@macro POKE_LOCAL_W(idx)
	RDD FP
	PSH idx*2
	ADD
	POKE_W
@macro_end



@macro CALL(name, args_count)
	PSH args_count
	jsr name
@macro_end

@macro CALL_W(name, args_count)
	PSH args_count*2
	jsr name
@macro_end


@macro FUNC(name, ret_count, body)
	ARG_LABEL name
	PROLOGUE()
	body
	PSH ret_count
	EPILOGUE()
	RTS
@macro_end


@macro FUNC_W(name, ret_count, body)
	ARG_LABEL name
	PROLOGUE()
	body
	PSH ret_count*2
	EPILOGUE()
	RTS
@macro_end


@macro DRAW()
	PSH 1
	WRD $2001
@macro_end



PSH 42

PSH_W 24
CALL_W(checkup, 1)
WRD_W $300
WRD $400
DRAW()
TRAP: JMP TRAP


FUNC_W(checkup, 1,
	OVR OVR

	JSR WORD_ZERO
	JZ checkup_ret_zero
	OVR OVR
	SUB_W 1
	JSR WORD_ZERO
	JZ checkup_ret_one
	PEEK_LOCAL_W(0)
	SUB_W 1
	CALL_W(checkup, 1)
	PEEK_LOCAL_W(0)
	SUB_W 2
	CALL_W(checkup, 1)
	ADD_W
	POKE_LOCAL_W(0)
	JMP checkup_ret
	checkup_ret_one:
	PSH_W 1
	POKE_LOCAL_W(0)
	JMP checkup_ret 
	checkup_ret_zero:
	PSH_W 0
	POKE_LOCAL_W(0)
	checkup_ret:
)

WORD_ZERO:
	
	JZ HIGH_ZERO
	POP
	PSH 1
	RTS
	HIGH_ZERO:
	JZ LOW_ZERO
	PSH 1
	RTS
	LOW_ZERO:
	PSH 0
	RTS
